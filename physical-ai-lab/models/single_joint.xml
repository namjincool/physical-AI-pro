<mujoco model="single_joint_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <light pos="0 0 2"/>
    <!-- Visual pivot only: exclude the overlapping sphere from contact dynamics. -->
    <geom name="base" type="sphere" size="0.06" rgba="0.3 0.3 0.3 1"
          contype="0" conaffinity="0"/>
    <body name="arm">
      <joint name="joint1" type="hinge" axis="0 1 0" damping="1"
             limited="true" range="-3.14 3.14"/>
      <geom name="link" type="capsule" fromto="0 0 0 0.6 0 0" size="0.04"
            mass="1" rgba="0.2 0.5 0.9 1"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="joint_motor" joint="joint1" gear="1"
           ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
